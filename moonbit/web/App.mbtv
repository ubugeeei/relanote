<script>
import {
  "mizchi/luna/js/resource" @reactivity,
  "ubugeeei/relanote/web" @playground,
  let signal = @reactivity.signal,
  let computed = @reactivity.computed,
}

const EXAMPLE : String =
  #|scale Major = { R, M2, M3, P4, P5, M6, M7 }
  #|
  #|let theme = | <1> <3> <5> <3> <1> |
  #|
  #|theme |> transpose P5 |> repeat 2

let source = signal(EXAMPLE)
let result = signal("Ready")

fn join_lines(lines : Array[String]) -> String {
  let mut out = ""
  for line in lines {
    if out.is_empty() {
      out = line
    } else {
      out = out + "\n" + line
    }
  }
  out
}

let diagnostics = computed(fn() {
  let lines = @playground.diagnose(source.get())
  if lines.length() == 0 {
    "No diagnostics"
  } else {
    join_lines(lines)
  }
})

fn load_example() -> Unit {
  source.set(EXAMPLE)
  result.set("Example loaded")
}

fn format_source() -> Unit {
  source.set(@playground.format(source.get()))
  result.set("Formatted")
}

fn run_source() -> Unit {
  result.set(@playground.run(source.get()))
}

fn render_midi() -> Unit {
  let bytes = @playground.render(source.get())
  result.set("Rendered " + bytes.length().to_string() + " MIDI bytes")
}
</script>

<template>
  <main class='relanote-app'>
    <section class='workspace' aria-labelledby='workspace-title'>
      <header class='toolbar'>
        <div>
          <p class='eyebrow'>relanote playground</p>
          <h1 id='workspace-title'>Relative music, live in MoonBit</h1>
        </div>
        <nav class='actions' aria-label='Playground actions'>
          <button type='button' @click='load_example()'>Example</button>
          <button type='button' @click='format_source()'>Format</button>
          <button type='button' @click='run_source()'>Run</button>
          <button type='button' class='primary' @click='render_midi()'>Render MIDI</button>
        </nav>
      </header>

      <div class='panes'>
        <label class='editor'>
          <span>Source</span>
          <textarea
            :value='source.get()'
            @input='source.set(_event._get("target")._get("value").cast())'
            spellcheck='false'
            aria-label='Relanote source'
          ></textarea>
        </label>

        <aside class='inspector' aria-label='Playground output'>
          <section>
            <h2>Diagnostics</h2>
            <pre>{{ diagnostics() }}</pre>
          </section>
          <section>
            <h2>Result</h2>
            <pre>{{ result.get() }}</pre>
          </section>
        </aside>
      </div>
    </section>
  </main>
</template>

<style>
.relanote-app {
  min-height: 100vh;
  background: #f6f7fb;
  color: #1c1b19;
  font-family: Inter, ui-sans-serif, system-ui, sans-serif;
}

.workspace {
  display: grid;
  gap: 1rem;
  margin: 0 auto;
  max-width: 1180px;
  padding: 2rem;
}

.toolbar {
  align-items: end;
  display: flex;
  gap: 1rem;
  justify-content: space-between;
}

.eyebrow {
  color: #0f766e;
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0;
  margin: 0 0 0.35rem;
  text-transform: uppercase;
}

h1,
h2 {
  margin: 0;
}

h1 {
  font-size: 2rem;
  line-height: 1.1;
}

h2 {
  font-size: 0.95rem;
}

.actions {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  justify-content: flex-end;
}

button {
  background: #ffffff;
  border: 1px solid #d8dde8;
  border-radius: 0.35rem;
  color: #1c1b19;
  cursor: pointer;
  font: inherit;
  font-weight: 650;
  min-height: 2.35rem;
  padding: 0 0.8rem;
}

button.primary {
  background: #0f766e;
  border-color: #0f766e;
  color: #ffffff;
}

.panes {
  display: grid;
  gap: 1rem;
  grid-template-columns: minmax(0, 1.3fr) minmax(280px, 0.7fr);
}

.editor,
.inspector {
  background: #ffffff;
  border: 1px solid #d8dde8;
  border-radius: 0.5rem;
}

.editor {
  display: grid;
  gap: 0.75rem;
  min-height: 560px;
  padding: 1rem;
}

.editor span {
  font-weight: 700;
}

textarea {
  border: 0;
  color: #202020;
  font: 0.95rem/1.55 ui-monospace, SFMono-Regular, Menlo, monospace;
  min-height: 470px;
  outline: 0;
  resize: vertical;
  width: 100%;
}

.inspector {
  display: grid;
  gap: 1rem;
  padding: 1rem;
}

.inspector section {
  display: grid;
  gap: 0.65rem;
}

pre {
  background: #202020;
  border-radius: 0.35rem;
  color: #f8f5ee;
  margin: 0;
  min-height: 8rem;
  overflow: auto;
  padding: 0.85rem;
  white-space: pre-wrap;
}

@media (max-width: 820px) {
  .workspace {
    padding: 1rem;
  }

  .toolbar,
  .panes {
    grid-template-columns: 1fr;
  }

  .toolbar {
    align-items: stretch;
    display: grid;
  }

  .actions {
    justify-content: start;
  }
}
</style>
