<script>
import {
  "mizchi/luna/js/resource" @reactivity,
  "ubugeeei/relanote/src/studio" @playground,
  let signal = @reactivity.signal,
  let computed = @reactivity.computed,
}

let active0 = @playground.load_active_name()
let shared = @playground.read_shared_code()
let source0 = match shared {
  Some(code) => code
  None => @playground.load_file(active0, @playground.default_source())
}

let files = signal(@playground.ensure_name(@playground.load_file_names(), active0))
let active = signal(active0)
let source = signal(source0)
let result = signal("Ready")
let beat = signal(0.0)

let diagnostics = computed(fn() {
  let lines = @playground.diagnose(source.get())
  if lines.length() == 0 { "Clean: no diagnostics" } else { @playground.join_lines(lines) }
})

let summary = computed(fn() { @playground.playground_summary(source.get()) })

fn save_current() -> Unit {
  @playground.save_file(active.get(), source.get())
  @playground.save_file_names(files.get())
  @playground.save_active_name(active.get())
  result.set("Saved " + active.get())
}

fn select_file(name : String) -> Unit {
  save_current()
  active.set(name)
  source.set(@playground.load_file(name, @playground.default_source()))
  @playground.save_active_name(name)
  result.set("Loaded " + name)
}

fn new_file() -> Unit {
  match @playground.prompt_text("New file name", "untitled.rela") {
    Some(name) => {
      save_current()
      files.set(@playground.ensure_name(files.get(), name))
      active.set(name)
      source.set(@playground.default_source())
      save_current()
    }
    None => ()
  }
}

fn rename_file() -> Unit {
  let old = active.get()
  match @playground.prompt_text("Rename file", old) {
    Some(name) => {
      files.set(@playground.ensure_name(@playground.remove_name(files.get(), old), name))
      @playground.delete_file(old)
      active.set(name)
      save_current()
    }
    None => ()
  }
}

fn delete_file() -> Unit {
  let old = active.get()
  @playground.delete_file(old)
  let next = @playground.remove_name(files.get(), old)
  let fixed = if next.length() == 0 { ["main.rela"] } else { next }
  files.set(fixed)
  active.set(@playground.first_name(fixed))
  source.set(@playground.load_file(active.get(), @playground.default_source()))
  save_current()
}

fn import_file() -> Unit {
  @playground.import_rela(fn(name, text) {
    files.set(@playground.ensure_name(files.get(), name))
    active.set(name)
    source.set(text)
    save_current()
    result.set("Imported " + name)
  })
}

fn format_source() -> Unit {
  source.set(@playground.format(source.get()))
  result.set("Formatted")
}

fn run_source() -> Unit {
  result.set(@playground.run(source.get()))
}

fn export_source() -> Unit {
  @playground.download_text(active.get(), source.get())
  result.set("Exported " + active.get())
}

fn export_project() -> Unit {
  @playground.download_project(files.get(), active.get(), source.get())
  result.set("Exported project")
}

fn export_midi() -> Unit {
  let bytes = @playground.render(source.get())
  if bytes.length() > 0 {
    @playground.download_bytes(active.get() + ".mid", bytes)
    result.set("Exported " + bytes.length().to_string() + " MIDI bytes")
  } else {
    result.set("Nothing to export")
  }
}

fn share_source() -> Unit {
  let url = @playground.share_code(source.get())
  result.set("Copied " + url)
}

fn play() -> Unit {
  @playground.play_sequence(@playground.events_json(source.get()), 120)
  result.set("Playing preview")
}

fn stop() -> Unit {
  @playground.stop_audio()
  result.set("Stopped")
}

fn file_class(name : String) -> String {
  if name == active.get() { "file active" } else { "file" }
}
</script>

<template>
  <main class='studio-app'>
    <header class='topbar'>
      <div class='brand'><strong>relanote</strong><span>Studio</span></div>
      <nav>
        <button @click='save_current()'><i class='ico save'></i>Save</button>
        <button @click='share_source()'><i class='ico share'></i>Share</button>
        <button @click='export_source()'><i class='ico file'></i>Source</button>
        <button @click='export_project()'><i class='ico stack-icon'></i>Project</button>
        <button @click='export_midi()'><i class='ico midi'></i>MIDI</button>
      </nav>
    </header>
    <section class='workbench'>
      <aside class='library'>
        <div class='panel-title'><span>Files</span><button @click='new_file()'><i class='ico add'></i>New</button></div>
        <button v-for='name in files.get()' :class='file_class(name)' @click='select_file(name)'>{{ name }}</button>
        <div class='stack'>
          <button @click='rename_file()'><i class='ico edit'></i>Rename</button>
          <button @click='delete_file()'><i class='ico trash'></i>Delete</button>
          <button @click='import_file()'><i class='ico import'></i>Import</button>
        </div>
        <div class='track-card'><b>Melody</b><span>Lead</span><i></i></div>
        <div class='track-card alt'><b>Harmony</b><span>Pad</span><i></i></div>
      </aside>
      <section class='composer'>
        <div class='transport'>
          <button class='play' @click='play()'><i class='ico play-icon'></i>Play</button>
          <button @click='stop()'><i class='ico stop-icon'></i>Stop</button>
          <span>{{ summary() }}</span>
          <span class='time'>1.1.000</span>
        </div>
        <div class='timeline'><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
        <div class='editor-head'>
          <span>{{ active.get() }}</span>
          <div><button @click='format_source()'><i class='ico format'></i>Format</button><button @click='run_source()'><i class='ico run'></i>Run</button></div>
        </div>
        <textarea :value='source.get()' @input='source.set(_event._get("target")._get("value").cast())' spellcheck='false'></textarea>
        <div class='status'><span>{{ result.get() }}</span><span>MoonBit pipeline</span></div>
      </section>
      <aside class='inspector'>
        <section><h2>Staff</h2><div class='viz' v-unsafe-html='@playground.staff_html(source.get(), beat.get())'></div></section>
        <section><h2>Piano Roll</h2><div class='viz roll' v-unsafe-html='@playground.piano_html(source.get(), beat.get())'></div></section>
        <section><h2>Diagnostics</h2><pre>{{ diagnostics() }}</pre></section>
        <section><h2>Console</h2><pre>{{ result.get() }}</pre></section>
      </aside>
    </section>
  </main>
</template>

<style>
.studio-app { --bg:#f7f2e8; --ink:#0c0b0d; --muted:#6d6864; --panel:rgba(255,251,243,.82); --signal:#ff4f7a; --pulse:#caff55; --amber:#ffd05a; --mint:#00d29e; --violet:#a970ff; min-height:100vh; background:linear-gradient(118deg,rgba(255,79,122,.12),transparent 32rem),linear-gradient(292deg,rgba(202,255,85,.1),transparent 34rem),linear-gradient(180deg,#fffaf0,#f7f2e8 42rem,#eee8dc); color:var(--ink); font-family:-apple-system,BlinkMacSystemFont,"SF Pro Text","Segoe UI",sans-serif; }
.topbar { align-items:center; backdrop-filter:saturate(180%) blur(24px); background:rgba(255,251,243,.76); box-shadow:0 1px 0 rgba(255,255,255,.34),0 10px 34px rgba(44,23,5,.08); display:flex; gap:1rem; justify-content:space-between; min-height:64px; padding:0 18px; position:sticky; top:0; z-index:3; }
.brand { display:flex; align-items:baseline; gap:.55rem; } .brand strong { font-size:1.08rem; letter-spacing:.01em; } .brand span,.time,.status { color:var(--muted); font-size:.82rem; }
nav,.transport,.editor-head div,.stack,.panel-title { align-items:center; display:flex; flex-wrap:wrap; gap:.45rem; }
button { align-items:center; background:rgba(255,255,255,.58); border:0; border-radius:999px; box-shadow:inset 0 1px 0 rgba(255,255,255,.35),0 8px 20px rgba(44,23,5,.06); color:var(--ink); cursor:pointer; display:inline-flex; font:inherit; font-size:.82rem; gap:.34rem; min-height:2.1rem; padding:0 .72rem; }
button:hover,.play { background:var(--signal); color:white; text-decoration:none; }
.workbench { display:grid; gap:12px; grid-template-columns:210px minmax(420px,1fr) minmax(360px,.72fr); height:calc(100vh - 64px); min-height:680px; padding:12px; }
.library,.composer,.inspector { background:var(--panel); box-shadow:0 30px 90px rgba(44,23,5,.14),inset 0 1px 0 rgba(255,255,255,.32); overflow:hidden; }
.library,.inspector { overflow:auto; padding:12px; } .library { display:flex; flex-direction:column; gap:8px; }
.panel-title { justify-content:space-between; color:var(--muted); font-size:.76rem; font-weight:700; text-transform:uppercase; }
.file { background:transparent; border-radius:0; box-shadow:inset 0 -1px rgba(12,11,13,.1); justify-content:flex-start; overflow:hidden; padding-left:1.75rem; position:relative; text-align:left; text-overflow:ellipsis; white-space:nowrap; }
.file::before { background:currentColor; clip-path:polygon(16% 0,68% 0,88% 20%,88% 100%,16% 100%); content:""; height:.9rem; left:.4rem; opacity:.58; position:absolute; width:.72rem; }
.file.active { background:linear-gradient(90deg,rgba(255,79,122,.18),transparent); box-shadow:inset 3px 0 var(--signal),inset 0 -1px rgba(12,11,13,.1); color:var(--ink); }
.stack { box-shadow:inset 0 1px rgba(255,255,255,.34); margin-top:4px; padding-top:10px; }
.track-card { background:#0d0b12; color:white; display:grid; gap:.25rem; margin-top:4px; padding:14px; position:relative; }
.track-card span { color:#c8bdaf; font-size:.8rem; } .track-card i { background:linear-gradient(90deg,var(--pulse),var(--signal)); height:5px; margin-top:.45rem; width:72%; } .track-card.alt i { background:linear-gradient(90deg,var(--amber),var(--mint)); width:54%; }
.composer { display:grid; grid-template-rows:52px 38px 44px 1fr 38px; min-width:0; }
.transport,.editor-head,.status { box-shadow:inset 0 -1px rgba(255,255,255,.26); display:flex; justify-content:space-between; padding:0 12px; }
.transport { background:rgba(255,255,255,.42); } .timeline { align-items:center; background:#0d0b12; display:grid; gap:1px; grid-template-columns:repeat(8,1fr); padding:0 10px; } .timeline i { background:rgba(255,248,237,.18); height:18px; width:1px; }
.editor-head { align-items:center; } textarea { background:#090b10; border:0; color:#f7fbff; font:.94rem/1.58 "SF Mono",ui-monospace,Menlo,monospace; outline:0; padding:18px; resize:none; width:100%; }
.status { align-items:center; box-shadow:inset 0 1px rgba(255,255,255,.26); }
.inspector { display:grid; gap:12px; grid-auto-rows:max-content; } h2 { color:var(--muted); font-size:.78rem; margin:0 0 7px; text-transform:uppercase; }
.viz,pre { background:#0d0b12; color:#fff8ed; overflow:auto; }
.viz svg { display:block; height:174px; min-width:100%; } .roll svg { height:150px; }
pre { margin:0; max-height:11rem; padding:10px; white-space:pre-wrap; }
.ico { display:inline-block;height:.88rem;width:.88rem; } .ico::before { background:currentColor; content:""; display:block; height:100%; width:100%; } .ico.play-icon::before,.ico.run::before{clip-path:polygon(24% 12%,88% 50%,24% 88%)}.ico.stop-icon::before{clip-path:inset(18%)}.ico.save::before,.ico.file::before{clip-path:polygon(12% 8%,78% 8%,90% 22%,90% 92%,12% 92%)}.ico.share::before,.ico.import::before{clip-path:polygon(12% 44%,58% 44%,58% 20%,92% 50%,58% 80%,58% 56%,12% 56%)}.ico.add::before{clip-path:polygon(42% 8%,58% 8%,58% 42%,92% 42%,92% 58%,58% 58%,58% 92%,42% 92%,42% 58%,8% 58%,8% 42%,42% 42%)}.ico.trash::before{clip-path:polygon(24% 18%,76% 18%,76% 28%,84% 28%,76% 92%,24% 92%,16% 28%,24% 28%)}.ico.edit::before{clip-path:polygon(68% 8%,92% 32%,36% 88%,12% 92%,16% 68%)}.ico.midi::before,.ico.stack-icon::before,.ico.format::before{clip-path:polygon(10% 28%,92% 28%,92% 48%,74% 48%,74% 72%,56% 72%,56% 48%,40% 48%,40% 72%,22% 72%,22% 48%,10% 48%)}
@media (prefers-color-scheme:dark){.studio-app{--bg:#08070a;--ink:#fff8ed;--muted:#b5aca1;--panel:rgba(24,22,27,.82);background:linear-gradient(118deg,rgba(255,79,122,.22),transparent 32rem),linear-gradient(292deg,rgba(202,255,85,.13),transparent 34rem),linear-gradient(180deg,#131016,#08070a 40rem,#030304)}.topbar,button{background:rgba(24,22,27,.78);color:var(--ink)}.transport{background:rgba(255,255,255,.045)}}
@media (max-width:1040px){.workbench{grid-template-columns:1fr;height:auto}.library{flex-direction:row;flex-wrap:wrap}.composer{min-height:720px}}
</style>
