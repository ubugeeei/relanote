import {
  "ubugeeei/relanote/src/preview" @preview,
}

supported_targets = "wasm-gc"

options(
  "is-main": true,
  link: {
    "wasm-gc": {
      "exports": [
        "main",
        "events_json",
        "playground_summary",
        "preview_tempo",
        "staff_html",
        "piano_html",
      ],
      "use-js-builtin-string": true,
    },
  },
)
